rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.teacherId == request.auth.uid;
    }

    match /students/{studentId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /observations/{observationId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /evaluations/{evaluationId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
