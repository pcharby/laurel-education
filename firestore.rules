rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.teacherId == request.auth.uid;
    }

    match /classes/{classId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /students/{studentId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /observations/{observationId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /evaluations/{evaluationId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    // Written only by Cloud Functions triggers (Admin SDK bypasses these
    // rules entirely) - teachers can read their own audit trail, no client
    // can ever write one directly.
    match /auditLogs/{logId} {
      allow read: if ownsExisting();
      allow write: if false;
    }

    // Rate-limit counters are an internal Cloud Functions concern only.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Bug/feedback reports: any signed-in user can file one for themselves,
    // but can't read, edit, or delete reports afterward (their own or
    // anyone else's) - reviewed directly in the console.
    match /bugReports/{reportId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if false;
    }

    // Teacher profile: doc ID is the teacher's own uid, so ownership is
    // just an ID match rather than a stamped teacherId field.
    match /teacherProfiles/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }

    // Curriculum resources are a shared, cross-teacher library (not scoped
    // to one teacher) - any signed-in teacher can read/add, but only the
    // teacher who added a resource can remove it. No update: if a resource
    // needs correcting, add a replacement instead of editing shared content
    // in place.
    match /curriculumResources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.addedByTeacherId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.addedByTeacherId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
