rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    function ownsIncoming() {
      return isSignedIn() && request.resource.data.teacherId == request.auth.uid;
    }

    // School-year lockdown: 2 days after a teacher's chosen schoolYearEndDate,
    // creates/updates on their classroom data are blocked - purely derived
    // from request.time, so it engages/releases instantly with no cron in
    // the loop. `is timestamp` doubles as the "never set a date" no-op guard:
    // an absent field short-circuits to false before the + arithmetic runs.
    // Deletes are never gated (see deleteAllMyData/right-to-erasure), and
    // evaluations are never gated (report generation should keep working
    // past lockout - see functions/src/schoolYearLockdown.ts for the
    // archival side of this feature).
    //
    // Two separate throw hazards here, both found live-testing (the second
    // one only surfaced testing a profile that had schoolName set but no
    // schoolYearEndDate - i.e. any teacher who's ever visited Settings
    // without touching the school-year field, likely the most common real
    // profile shape there is):
    //   1. .data on a get() of a document that doesn't exist throws - a
    //      brand-new teacher has no teacherProfiles doc at all yet.
    //   2. Dot-accessing a map key that doesn't exist on an existing
    //      document ALSO throws in Firestore rules (unlike plain JS
    //      undefined) - schoolYearEndDate is optional, so an existing
    //      profile very often won't have it set.
    // exists() guards hazard 1. For hazard 2, the `in` operator checks map
    // key presence without ever dot-accessing the key, so it can't throw
    // even when absent - unlike the map's two-arg .get(key, default), whose
    // deploy-time type checker won't accept `null` as the default's type
    // (int/float/string/duration/timestamp only), which is what led here.
    // && short-circuits before any dot-access happens once hasEndDate is
    // false, so schoolYearEndDate is only ever dot-accessed once its
    // presence is already confirmed.
    function isTeacherLocked() {
      let profilePath = /databases/$(database)/documents/teacherProfiles/$(request.auth.uid);
      let hasEndDate = exists(profilePath) && 'schoolYearEndDate' in get(profilePath).data;
      return hasEndDate
        && get(profilePath).data.schoolYearEndDate is timestamp
        && request.time > get(profilePath).data.schoolYearEndDate + duration.value(2, 'd');
    }

    // Schools: which of a teacher's schools a class/student belongs to.
    // Structural, not annual classroom content, so unlike classes/students/
    // rubrics/strands it's never gated by isTeacherLocked() - same reasoning
    // as teacherProfiles staying writable through a lockdown.
    match /schools/{schoolId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /classes/{classId} {
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && !isTeacherLocked();
      allow create: if ownsIncoming() && !isTeacherLocked();
    }

    match /rubrics/{rubricId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && !isTeacherLocked();
      allow update: if false;
    }

    match /strands/{strandId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && !isTeacherLocked();
      allow update: if false;
    }

    match /students/{studentId} {
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && !isTeacherLocked();
      allow create: if ownsIncoming() && !isTeacherLocked();
    }

    match /observations/{observationId} {
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && !isTeacherLocked();
      allow create: if ownsIncoming() && !isTeacherLocked();
    }

    match /evaluations/{evaluationId} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    // Written only by Cloud Functions triggers (Admin SDK bypasses these
    // rules entirely) - teachers can read their own audit trail, no client
    // can ever write one directly.
    match /auditLogs/{logId} {
      allow read: if ownsExisting();
      allow write: if false;
    }

    // Rate-limit counters are an internal Cloud Functions concern only.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Bug/feedback reports: any signed-in user can file one for themselves,
    // but can't read, edit, or delete reports afterward (their own or
    // anyone else's) - reviewed directly in the console.
    match /bugReports/{reportId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if false;
    }

    // Teacher profile: doc ID is the teacher's own uid, so ownership is
    // just an ID match rather than a stamped teacherId field.
    match /teacherProfiles/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }

    // Curriculum resources are a shared, cross-teacher library (not scoped
    // to one teacher) - any signed-in teacher can read/add, but only the
    // teacher who added a resource can remove it. No update: if a resource
    // needs correcting, add a replacement instead of editing shared content
    // in place.
    match /curriculumResources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.addedByTeacherId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.addedByTeacherId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
