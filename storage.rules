rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Curriculum files are a shared, cross-teacher library, mirroring the
    // curriculumResources Firestore collection. Any signed-in teacher can
    // read or upload; delete is checked against the matching Firestore
    // doc's addedByTeacherId so only the uploader can remove their own file
    // (same rule as the Firestore side - kept in sync intentionally).
    match /curriculum/{resourceId}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches(
             'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|text/plain'
           );

      allow update: if false;

      allow delete: if request.auth != null &&
        firestore.get(/databases/(default)/documents/curriculumResources/$(resourceId)).data.addedByTeacherId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
